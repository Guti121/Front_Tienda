# Copiar a .env. Expo inyecta las variables EXPO_PUBLIC_* en el bundle.
# (Se usará en Fase 1, cuando el cliente API deje de tener la URL hardcodeada.)

EXPO_PUBLIC_API_URL=https://api-micatalogo.4tomo.app/

# Base de la mini-app web del catálogo (repo `catalog-web`). La app ya no
# renderiza el catálogo: solo comparte el enlace <CATALOG_URL>/<nombre-tienda>.
EXPO_PUBLIC_CATALOG_URL=http://localhost:3000/
