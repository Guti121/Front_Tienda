{
  "expo": {
    "name": "Mi Catálogo",
    "slug": "front-tienda",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "mystockapp",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#121212"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "site.mystockapp.app"
    },
    "android": {
      "package": "site.mystockapp.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#121212"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "La app usa la cámara para escanear códigos de barras de los productos."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "La app accede a tus fotos para elegir la imagen de un producto.",
          "cameraPermission": "La app usa la cámara para tomar la foto de un producto."
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://api.mystockapp.site/"
    }
  }
}
